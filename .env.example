# 성인 운영자가 Groq 무료 플랜에서 발급한 키를 .dev.vars에 설정하세요.
# 실제 키를 Git, 채팅, 브라우저 코드에 넣지 마세요.
GROQ_API_KEY=

# Web Push 서버용 P-256 키 (선택). 공개 저장소에 실제 값을 넣지 마세요.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-site.example

# 정기 점검 전용 키. 알람 발송 점검만 허용하며 사용자 기록 API 로그인과 별개입니다.
ALARM_TICK_KEY=
